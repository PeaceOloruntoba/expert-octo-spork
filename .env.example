# Server
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (Postgres). Works with any Postgres provider (Neon, Supabase, Railway, RDS, etc.)
# For serverless deploys (Vercel), prefer a pooled connection string (e.g. Neon's "pooled" URL,
# or Supabase's "Transaction" pooler on port 6543) since each invocation opens a fresh pool.
DATABASE_URL=postgres://user:password@localhost:5432/fertility_marketplace
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Auth / JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMTP (nodemailer) - used for verify-email / password reset / notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey_or_username
SMTP_PASS=change_me
SMTP_FROM="Bunzi Fertility Marketplace <no-reply@example.com>"

# Frontend URL (used to build links in emails)
APP_URL=http://localhost:5173

# Mock third-party integrations (vendors not yet contracted per PRD §8)
KYC_MOCK_MODE=true
ESCROW_MOCK_MODE=true
GENETIC_LAB_MOCK_MODE=true
